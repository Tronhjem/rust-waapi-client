{
  "optionsSchema": {
    "type": "object",
    "properties": {
      "return": {
        "description": "Data to be returned for the SoundBank generated. Refer to \\ref wobjects_index for more information on the properties available.",
        "$ref": "waapi_definitions.json#/definitions/returnExpression"
      },
      "infoFile": {
        "type": "boolean",
        "description": "Embed the JSON SoundBank info file in the response."
      },
      "bankData": {
        "type": "boolean",
        "description": "Embed the base64 SoundBank data in the response."
      },
      "pluginInfo": {
        "type": "boolean",
        "description": "Embed the JSON PluginInfo file in the response."
      }
    },
    "additionalProperties": false
  },
  "publishSchema": {
    "type": "object",
    "properties": {
      "platform": {
        "type": "object",
        "description": "The platform for which the SoundBank was generated."
      },
      "soundbank": {
        "description": "The generated SoundBank. Use the return options to obtain specific details.",
        "$ref": "waapi_definitions.json#/definitions/objectReturn"
      },
      "language": {
        "type": "object",
        "description": "The language for which the SoundBank was generated. Only present when generating a SoundBank for a specific language."
      },
      "bankData": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "description": "Size of the SoundBank data when decoded."
          },
          "data": {
            "type": "string",
            "description": "Data of the SoundBank encoded in base64."
          }
        },
        "description": "SoundBank data object containing the actual data encoded in base64 and the size."
      },
      "pluginInfo": {
        "type": "object",
        "properties": {
          "Platform": {
            "type": "string",
            "description": "Name of the platform."
          },
          "BasePlatform": {
            "type": "string",
            "description": "The base platform the current platform is based off."
          },
          "PluginLibs": {
            "type": "array",
            "description": "List of the plugins",
            "items": {
              "type": "object",
              "properties": {
                "Type": {
                  "type": "string",
                  "description": "Type of the plugin."
                },
                "LibName": {
                  "type": "string",
                  "description": "Display Name of the plugin."
                },
                "LibId": {
                  "type": "string",
                  "description": "Short ID of the plugin."
                },
                "DLL": {
                  "type": "string",
                  "description": "Name of the DLL for the plugin."
                },
                "StaticLib": {
                  "type": "string",
                  "description": "Name of the static lib for the plugin."
                }
              },
              "description": "Plugin information.",
              "required": [
                "LibName",
                "LibId",
                "Type"
              ],
              "additionalProperties": false
            }
          }
        },
        "description": "PluginInfo file info",
        "required": [
          "Platform",
          "BasePlatform"
        ],
        "additionalProperties": false
      },
      "error": {
        "type": "string",
        "description": "The error message, if an error occurred. Only present if an error occurred."
      },
      "bankInfo": {
        "type": "array",
        "description": "All the information for SoundBank.",
        "items": {
          "type": "object",
          "properties": {
            "Color": {
              "$ref": "#/definitions/color"
            },
            "Align": {
              "type": "string",
              "description": "Required alignment for media file. If not specified then the alignment is 16 bytes."
            },
            "Type": {
              "type": "string",
              "description": "SoundBank type. If the SoundBank is defined by the user, then the type is 'User'. Otherwise, the bank was auto defined by Wwise.",
              "enum": [
                "User",
                "Event",
                "Bus"
              ]
            },
            "Language": {
              "type": "string",
              "description": "The name of the language being used in this SoundBank."
            },
            "Id": {
              "type": "string",
              "description": "Short ID of the resulting bank encoded in a string."
            },
            "GUID": {
              "description": "GUID of the resulting SoundBank.",
              "$ref": "common_definitions.json#/definitions/guid"
            },
            "ObjectPath": {
              "type": "string",
              "description": "Object path in the project."
            },
            "ShortName": {
              "type": "string",
              "description": "The name of the SoundBank."
            },
            "Path": {
              "type": "string",
              "description": "The file name of the SoundBank."
            },
            "Hash": {
              "type": "string",
              "description": "Hash value (128-bit) written to the associated SoundBank .bnk file. Used during SoundBank generation to check existing .bnk files for changes."
            },
            "DeviceMemory": {
              "type": "string",
              "description": "Does the media requires device memory or not.",
              "enum": [
                "true",
                "false"
              ]
            },
            "Media": {
              "type": "array",
              "description": "All media files referenced by this SoundBank with their information.",
              "items": {
                "$ref": "waapi_definitions.json#/definitions/mediaDescriptor",
                "additionalProperties": false
              }
            },
            "ExternalSources": {
              "type": "array",
              "description": "All external sources referenced by this SoundBank with their information.",
              "items": {
                "description": "External source descriptor.",
                "#ref": "waapi_definitions.json#/definitions/externalSourceDescriptor"
              }
            },
            "Plugins": {
              "description": "Plug-in descriptors.",
              "#ref": "waapi_definitions.json#/definitions/pluginDescriptorGroup"
            },
            "Events": {
              "type": "array",
