                  },
                  "MediaRefs": {
                    "type": "array",
                    "description": "List of all media files used by this event.",
                    "items": {
                      "description": "Referenced media file entry",
                      "$ref": "waapi_definitions.json#/definitions/mediaReference"
                    }
                  },
                  "ExternalSourceRefs": {
                    "type": "array",
                    "description": "List of all external sources used by this event.",
                    "items": {
                      "description": "Referenced external source entry",
                      "$ref": "waapi_definitions.json#/definitions/externalSourceReference"
