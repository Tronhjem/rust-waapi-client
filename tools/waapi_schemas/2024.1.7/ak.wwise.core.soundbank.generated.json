                  },
                  "MaxAttenuation": {
                    "type": "string",
                    "description": "The max distance for the attenuation of the event as a floating point value."
                  },
                  "DurationType": {
                    "type": "string",
                    "description": "The kind of duration, possible values: OneShot, Unknown, Infinite, Mixed."
