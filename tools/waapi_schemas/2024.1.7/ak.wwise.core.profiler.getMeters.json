              }
            ]
          },
          {
            "object": {
              "id": "{0DE372C2-4E96-4096-9E61-781BC76313F3}",
              "name": "Bus"
            },
            "source": "Bus",
            "configurationName": "7.1",
            "configurationMask": 1599,
            "configurationType": "Standard",
            "channels": [
              {
                "name": "L",
                "value": 0.00794849544763565
              },
              {
                "name": "R",
                "value": -764.6162109375
              },
              {
                "name": "C",
                "value": -764.6162109375
              },
              {
                "name": "BL",
                "value": -764.6162109375
              },
              {
                "name": "BR",
                "value": -764.6162109375
              },
              {
                "name": "SL",
                "value": -764.6162109375
              },
              {
                "name": "SR",
                "value": -764.6162109375
              },
              {
